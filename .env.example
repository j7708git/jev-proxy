# jev-proxy 本地密鑰檔。
# 用法：複製本檔為 .env 並填入真值。`.env` 已在 .gitignore 中——
# 不要提交、不要貼進對話或截圖。
#
# 載入順序（啟動自動）：-env 指定路徑 > ./.env > config.yaml 同目錄的 .env。
# 優先序：真實環境變數 > .env（shell 已設同名變數會蓋掉檔案值）。
# 變數名稱需與 config.yaml 各 api_key_env 一致；缺哪家只是那家會報錯，開機不受影響。

# ── gateway：路由用的各家 provider key（依 config.yaml 的 providers 增減）──
OPENROUTER_API_KEY=sk-or-replace-me
DEEPSEEK_API_KEY=replac…e-me
NOUS_API_KEY=replica…e-me

# ── 門鎖：設定後所有 /v1 請求都要帶這把（agent 端的 Authorization 填它）──
# 留空或拿掉這行＝不驗 key（預設只綁 127.0.0.1，同機程式都可用）
JEV_CLIENT_KEY=change…g-gate

# ── Jev 評分通道（與上面路由獨立；provider=openrouter 時重用 OPENROUTER_API_KEY）──
# typesafe 直連才需要：
# TYPESAFE_API_KEY=ts-replace-me

# 只放密鑰。非密鑰設定（port、門檻、路由表…）一律在 config.yaml。
